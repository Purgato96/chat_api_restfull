APP_NAME="Chat Interno"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=https://basedopurga.com.br


APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apirestfull
DB_USERNAME=purgato
DB_PASSWORD=Purgato$450***

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=2009394
PUSHER_APP_KEY=4597dddb362767ee2f19
PUSHER_APP_SECRET=5d5f92822dadb71be349
PUSHER_APP_CLUSTER=sa1

# Configurações do Vite para Pusher (serão usadas pelo frontend)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Domínios que podem usar autenticação stateful (SPA no mesmo domínio)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1

# Domínios permitidos para CORS (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Configurações adicionais da API
API_RATE_LIMIT=60
API_RATE_LIMIT_AUTHENTICATED=120
PUSHER_ALLOW_EXTERNAL_AUTH=true
API_REQUIRE_HTTPS=false # Mude para true em produção
API_ENABLE_RATE_LIMITING=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WWWGROUP=1000
WWWUSER=1000

SAIL_XDEBUG_MODE=debug


SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false
